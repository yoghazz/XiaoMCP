# Runtime Mode: local | vps
RUNTIME_MODE=local

# Orchestrator Config
PORT=3000
API_KEY=your_secure_api_key_here

# Database Config
# For LOCAL: Use SQLite path
DATABASE_URL="file:./dev.db"
# For VPS: Use PostgreSQL URL
# DATABASE_URL="postgresql://user:pass@localhost:5432/xo_db?schema=public"

# Telegram Config
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
