generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
}

model Worker {
  id             String       @id @default(uuid())
  name           String
  status         String       @default("OFFLINE")
  lastHeartbeat  DateTime     @default(now())
  jobs           Job[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Job {
  id             String       @id @default(uuid())
  correlationId  String?      @unique
  workflowName   String
  inputParams    String       // Store as string/JSON for SQLite compatibility
  status         String       @default("PENDING")
  resultData     String?      // Store as string/JSON for SQLite compatibility
  workerId       String?
  worker         Worker?      @relation(fields: [workerId], references: [id])
  events         JobEvent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
}

model JobEvent {
  id             Int          @id @default(autoincrement())
  jobId          String
  job            Job          @relation(fields: [jobId], references: [id])
  eventType      String
  message        String
  payload        String?      // Store as string/JSON for SQLite compatibility
  createdAt      DateTime     @default(now())
}
